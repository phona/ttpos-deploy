# TTPOS Deploy Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Core Configuration
# ===========================================

# Environment name (staging, production)
ENV=staging

# Container registry URL (replace with your actual registry)
IMAGE_REGISTRY=registry.example.com/your-org

# Image tag to deploy
# WARNING: Production requires explicit tag (not 'latest')
IMAGE_TAG=latest

# ===========================================
# Database Configuration
# ===========================================

# MySQL settings (managed by operations team)
DB_HOST=mysql-proxy
DB_PORT=3306
DB_DATABASE=ttpos
DB_USERNAME=ttpos
# DB_PASSWORD=  # Set in secrets file

# ===========================================
# Redis Configuration
# ===========================================

# Redis settings (managed by operations team)
REDIS_HOST=redis-proxy
REDIS_PORT=6379
# REDIS_PASSWORD=  # Set in secrets file

# ===========================================
# Service Discovery
# ===========================================

# BMP Microservices
BMP_ERP_HOST=bmp-erp
BMP_ERP_GRPC_PORT=14022

BMP_TAKEOUT_HOST=bmp-takeout
BMP_TAKEOUT_GRPC_PORT=14032

BMP_MESSAGE_HOST=bmp-message
BMP_MESSAGE_GRPC_PORT=14042

BMP_WEBSOCKET_HOST=bmp-websocket
BMP_WEBSOCKET_GRPC_PORT=14052

# ===========================================
# Logging Configuration
# ===========================================

LOG_LEVEL=info
LOG_FORMAT=json

# ===========================================
# Feature Flags
# ===========================================

# Enable pprof profiling (disable in production)
ENABLE_PPROF=true

# Enable Swagger documentation (disable in production)
ENABLE_SWAGGER=true

# ===========================================
# Port Configuration (for local/staging)
# ===========================================

MAIN_HTTP_PORT=8080
PHP_FPM_PORT=9000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ===========================================
# PHP Configuration
# ===========================================

PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=60
PHP_UPLOAD_MAX_FILESIZE=50M

# ===========================================
# Nginx Configuration
# ===========================================

NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# ===========================================
# Health Check Configuration
# ===========================================

HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ===========================================
# Deployment Configuration
# ===========================================

# Deployment path on target servers
DEPLOY_PATH=/opt/ttpos

# Git repository URL
GIT_REPO=https://github.com/your-org/ttops-deploy.git

# ===========================================
# Notification Configuration
# ===========================================

# Slack webhook URL (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# ===========================================
# Security (set in secrets file, not here!)
# ===========================================

# These should be set in environments/<env>/secrets/
# - DB_PASSWORD
# - REDIS_PASSWORD
# - JWT_SECRET
# - API_KEYS
# - NACOS_SECRET
