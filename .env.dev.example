# Local Development Environment
# Copy this file to .env.dev for local development
# Auto-loaded by docker-compose.dev.yml

# ===========================================
# Core Configuration
# ===========================================

ENV=dev
IMAGE_TAG=latest
IMAGE_REGISTRY=registry.example.com/your-org
PHP_IMAGE=hitosea2020/php-fpm:1.0.6

# ===========================================
# Infrastructure (local containers)
# ===========================================

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ttpos
DB_USERNAME=ttpos
DB_PASSWORD=ttpos123

REDIS_HOST=redis
REDIS_PORT=6379

NACOS_HOST=nacos
NACOS_PORT=8848
NACOS_NAMESPACE=dev

ROCKETMQ_NAMESRV=rocketmq-namesrv:9876

# ===========================================
# Service Discovery (container names)
# ===========================================

BMP_ERP_HOST=bmp-erp
BMP_ERP_GRPC_PORT=14022

BMP_TAKEOUT_HOST=bmp-takeout
BMP_TAKEOUT_GRPC_PORT=14032

BMP_MESSAGE_HOST=bmp-message
BMP_MESSAGE_GRPC_PORT=14042

BMP_WEBSOCKET_HOST=bmp-websocket
BMP_WEBSOCKET_GRPC_PORT=14052

# ===========================================
# Feature Flags (all enabled for dev)
# ===========================================

ENABLE_PPROF=true
ENABLE_SWAGGER=true
ENABLE_DEBUG=true
LOG_LEVEL=debug

# ===========================================
# PHP Settings
# ===========================================

PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=120
PHP_UPLOAD_MAX_FILESIZE=100M

# ===========================================
# Nginx Configuration
# ===========================================

NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# ===========================================
# Port Configuration
# ===========================================

MAIN_HTTP_PORT=8080
PHP_FPM_PORT=9000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ===========================================
# Health Check Configuration
# ===========================================

HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
