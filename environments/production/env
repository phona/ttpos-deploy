# Production Environment Configuration
# environments/production/env
# Compatible with ttpos-server-go production setup

# ===========================================
# Core Configuration
# ===========================================

ENV=production
APP_ID=prod
IMAGE_VERSION=latest
IMAGE_REGISTRY=hub.hitosea.com/ttpos-server

# ===========================================
# Network Configuration
# ===========================================

NETWORK_SUBNET=10.0.0.0/24
NETWORK_GATEWAY=10.0.0.1
BMP_NETWORK_SUBNET=10.0.10.0/24
BMP_NETWORK_GATEWAY=10.0.10.1

# Static IPs for services
MAIN_IP=10.0.0.18
PHP_IP=10.0.0.10
NGINX_IP=10.0.0.11
DB_IP=10.0.0.12
REDIS_IP=10.0.0.13

BMP_ERP_IP=10.0.10.42
BMP_TAKEOUT_IP=10.0.10.40
BMP_MESSAGE_IP=10.0.10.44
BMP_WEBSOCKET_IP=10.0.10.45

# ===========================================
# Database Configuration
# ===========================================

DB_HOST=mysql-proxy
DB_PORT=3306
DB_DATABASE=ttpos_prod
DB_USERNAME=ttpos
# DB_PASSWORD=  # Set in secrets file

# ===========================================
# Redis Configuration
# ===========================================

REDIS_HOST=redis-proxy
REDIS_PORT=6379
# REDIS_PASSWORD=  # Set in secrets file

# ===========================================
# Service Discovery (GRPC)
# ===========================================

# GRPC endpoints for BMP microservices
GRPC_ENDPOINTS=${SERVER_IP}

# BMP Microservices
BMP_ERP_HOST=bmp-erp
BMP_ERP_GRPC_PORT=14022

BMP_TAKEOUT_HOST=bmp-takeout
BMP_TAKEOUT_GRPC_PORT=14032

BMP_MESSAGE_HOST=bmp-message
BMP_MESSAGE_GRPC_PORT=14042

BMP_WEBSOCKET_HOST=bmp-websocket
BMP_WEBSOCKET_GRPC_PORT=14052

# ===========================================
# Nginx Configuration
# ===========================================

NGINX_PORT=80
NGINX_SSL_PORT=443
NGINX_HOST=localhost
SERVER_IP=127.0.0.1

# ===========================================
# Logging Configuration
# ===========================================

LOG_LEVEL=warn
LOG_FORMAT=json

# ===========================================
# Feature Flags (DISABLED in production)
# ===========================================

ENABLE_PPROF=false
ENABLE_SWAGGER=false

# ===========================================
# Port Configuration
# ===========================================

MAIN_HTTP_PORT=8080
PHP_FPM_PORT=9000

BMP_ERP_HTTP_PORT=14021
BMP_ERP_GRPC_PORT=14022

BMP_TAKEOUT_HTTP_PORT=14031
BMP_TAKEOUT_GRPC_PORT=14032

BMP_MESSAGE_HTTP_PORT=14041
BMP_MESSAGE_GRPC_PORT=14042

BMP_WEBSOCKET_HTTP_PORT=14051
BMP_WEBSOCKET_GRPC_PORT=14052

# ===========================================
# PHP Configuration
# ===========================================

PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=120
PHP_UPLOAD_MAX_FILESIZE=100M

# ===========================================
# Paths (relative to ttpos-server-go root)
# ===========================================

DOCKER_PATH=./docker
CERT_PATH=./docker/certificate
LOG_PATH=./docker/golang/logs
PUBLIC_PATH=./admin/public
DOCS_PATH=./docs
MAIN_DOCS_PATH=./main/docs
ADMIN_PATH=./admin
CONFIG_PATH=./app

# ===========================================
# Health Check Configuration
# ===========================================

HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ===========================================
# Deployment Configuration
# ===========================================

DEPLOY_PATH=/opt/ttpos/production
