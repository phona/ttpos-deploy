# Staging Environment Configuration
# environments/staging/env

# ===========================================
# Core Configuration
# ===========================================

ENV=staging
IMAGE_REGISTRY=registry.example.com/your-org
IMAGE_TAG=latest

# ===========================================
# Database Configuration
# ===========================================

# MySQL (managed by operations team)
DB_HOST=mysql-proxy
DB_PORT=3306
DB_DATABASE=ttpos_staging
DB_USERNAME=ttpos

# ===========================================
# Redis Configuration
# ===========================================

# Redis (managed by operations team)
REDIS_HOST=redis-proxy
REDIS_PORT=6379

# ===========================================
# Service Discovery
# ===========================================

# BMP Microservices
BMP_ERP_HOST=bmp-erp
BMP_ERP_GRPC_PORT=14022

BMP_TAKEOUT_HOST=bmp-takeout
BMP_TAKEOUT_GRPC_PORT=14032

BMP_MESSAGE_HOST=bmp-message
BMP_MESSAGE_GRPC_PORT=14042

BMP_WEBSOCKET_HOST=bmp-websocket
BMP_WEBSOCKET_GRPC_PORT=14052

# ===========================================
# Logging Configuration
# ===========================================

LOG_LEVEL=info
LOG_FORMAT=json

# ===========================================
# Feature Flags
# ===========================================

ENABLE_PPROF=true
ENABLE_SWAGGER=true

# ===========================================
# Port Configuration
# ===========================================

MAIN_HTTP_PORT=8080
PHP_FPM_PORT=9000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

BMP_ERP_HTTP_PORT=14020
BMP_ERP_GRPC_PORT=14022

BMP_TAKEOUT_HTTP_PORT=14030
BMP_TAKEOUT_GRPC_PORT=14032

BMP_MESSAGE_HTTP_PORT=14040
BMP_MESSAGE_GRPC_PORT=14042

BMP_WEBSOCKET_HTTP_PORT=14050
BMP_WEBSOCKET_WS_PORT=14051
BMP_WEBSOCKET_GRPC_PORT=14052

# ===========================================
# PHP Configuration
# ===========================================

PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=60
PHP_UPLOAD_MAX_FILESIZE=50M

# ===========================================
# Health Check Configuration
# ===========================================

HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ===========================================
# Deployment Configuration
# ===========================================

DEPLOY_PATH=/opt/ttpos/staging
