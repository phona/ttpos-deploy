# TTPOS Deploy Environment Configuration
# Copy this file to .env and fill in your values
# Compatible with ttpos-server-go production setup

# ===========================================
# Core Configuration
# ===========================================

# Environment name (staging, production)
ENV=staging

# Application ID for container naming (required for production)
APP_ID=dev

# Container registry
IMAGE_REGISTRY=hub.hitosea.com/ttpos-server

# Image version to deploy
# WARNING: Production requires explicit tag (not 'latest')
IMAGE_VERSION=latest

# ===========================================
# Network Configuration
# ===========================================

NETWORK_SUBNET=10.0.0.0/24
NETWORK_GATEWAY=10.0.0.1
BMP_NETWORK_SUBNET=10.0.10.0/24
BMP_NETWORK_GATEWAY=10.0.10.1

# ===========================================
# Database Configuration
# ===========================================

DB_HOST=mysql-proxy
DB_PORT=3306
DB_DATABASE=ttpos
DB_USERNAME=ttpos
# DB_PASSWORD=  # Set in secrets file

# ===========================================
# Redis Configuration
# ===========================================

REDIS_HOST=redis-proxy
REDIS_PORT=6379
# REDIS_PASSWORD=  # Set in secrets file

# ===========================================
# Service Discovery (GRPC)
# ===========================================

# GRPC endpoints for microservices (comma-separated host:port)
GRPC_ENDPOINTS=

# BMP Microservices
BMP_ERP_HOST=bmp-erp
BMP_ERP_GRPC_PORT=14022

BMP_TAKEOUT_HOST=bmp-takeout
BMP_TAKEOUT_GRPC_PORT=14032

BMP_MESSAGE_HOST=bmp-message
BMP_MESSAGE_GRPC_PORT=14042

BMP_WEBSOCKET_HOST=bmp-websocket
BMP_WEBSOCKET_GRPC_PORT=14052

# ===========================================
# Server Configuration
# ===========================================

SERVER_IP=127.0.0.1
NGINX_HOST=localhost

# ===========================================
# Logging Configuration
# ===========================================

LOG_LEVEL=info
LOG_FORMAT=json

# ===========================================
# Feature Flags
# ===========================================

ENABLE_PPROF=true
ENABLE_SWAGGER=true

# ===========================================
# Port Configuration
# ===========================================

MAIN_HTTP_PORT=8080
PHP_FPM_PORT=9000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

BMP_ERP_HTTP_PORT=14021
BMP_ERP_GRPC_PORT=14022

BMP_TAKEOUT_HTTP_PORT=14031
BMP_TAKEOUT_GRPC_PORT=14032

BMP_MESSAGE_HTTP_PORT=14041
BMP_MESSAGE_GRPC_PORT=14042

BMP_WEBSOCKET_HTTP_PORT=14051
BMP_WEBSOCKET_GRPC_PORT=14052

# ===========================================
# PHP Configuration
# ===========================================

PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=120
PHP_UPLOAD_MAX_FILESIZE=100M

# ===========================================
# Paths
# ===========================================

DOCKER_PATH=./docker
CERT_PATH=./docker/certificate
LOG_PATH=./docker/golang/logs
PUBLIC_PATH=./admin/public
DOCS_PATH=./docs
ADMIN_PATH=./admin
CONFIG_PATH=./app

# ===========================================
# Health Check Configuration
# ===========================================

HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ===========================================
# Deployment Configuration
# ===========================================

DEPLOY_PATH=/opt/ttpos
GIT_REPO=https://github.com/your-org/ttops-deploy.git

# ===========================================
# Security (set in secrets file, not here!)
# ===========================================

# - DB_PASSWORD
# - REDIS_PASSWORD
# - JWT_SECRET
# - API_KEYS
